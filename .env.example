# === Banco de Dados (usadas pelo profile prod) ===
# URL de conexão JDBC com o PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/eventflow

# Usuário do banco de dados
DB_USERNAME=eventflow_user

# Senha do banco de dados
DB_PASSWORD=eventflow_pass

# === Autenticação JWT ===
# Chave secreta para assinatura dos tokens (mínimo 32 caracteres)
JWT_SECRET=local-dev-secret-change-in-production

# Tempo de expiração do access token em milissegundos (padrão: 15min)
JWT_EXPIRATION_MS=900000

# Tempo de expiração do refresh token em milissegundos (padrão: 7 dias)
JWT_REFRESH_EXPIRATION_MS=604800000

# === Spring ===
# Profile ativo (dev, prod)
SPRING_PROFILES_ACTIVE=prod

# Porta do servidor (padrão: 8080)
PORT=8080
